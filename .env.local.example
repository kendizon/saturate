# Copy this file to .env.local and fill in your EmailJS credentials
# (create a free account at https://www.emailjs.com)
#
# If left blank, the contact form automatically falls back to opening
# the visitor's email client with a pre-filled message to
# thesaturateph@gmail.com — so the site works even without EmailJS set up.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
